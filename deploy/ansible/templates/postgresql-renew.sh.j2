#!/bin/sh
set -eu

# Other certificates on this server must not replace the viewer's identity.
[ "${RENEWED_LINEAGE:-}" = {{ ida_certificate_dir | quote }} ] || exit 0

# Stage both files before replacing either copy. A failed copy leaves the
# previous certificate and key in place; PostgreSQL reloads only after success.
tls_staging=$(/usr/bin/mktemp -d {{ (ida_postgresql_tls_dir + '/.renew.XXXXXX') | quote }})
trap '/bin/rm -rf "$tls_staging"' 0
trap 'exit 1' HUP INT TERM
/usr/bin/install -o root -g postgres -m 0644 \
  "$RENEWED_LINEAGE/fullchain.pem" "$tls_staging/server.crt"
/usr/bin/install -o root -g postgres -m 0640 \
  "$RENEWED_LINEAGE/privkey.pem" "$tls_staging/server.key"
/bin/mv -f "$tls_staging/server.crt" {{ (ida_postgresql_tls_dir + '/server.crt') | quote }}
/bin/mv -f "$tls_staging/server.key" {{ (ida_postgresql_tls_dir + '/server.key') | quote }}
/usr/bin/systemctl reload {{ ida_postgresql_service | quote }}
